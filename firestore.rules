rules_version = '2';

// Reglas para la app estática SIN PANTALLA DE LOGIN.
// La app entra con Firebase Auth anónimo (invisible para el usuario).
// Reemplazar TODO_UID por el ID copiado en "Información de sesión".

service cloud.firestore {
  match /databases/{database}/documents {

    function dentro() {
      return request.auth != null;
    }

    function esAdmin() {
      return dentro() && request.auth.uid == 'TODO_UID';
    }

    // Cualquier sesión anónima puede cotizar y ver el historial.
    // Solo el UID del administrador puede borrar o cambiar parámetros.
    match /cotizador_cotizaciones/{id} {
      allow read: if dentro();
      allow create: if dentro();
      allow update, delete: if esAdmin();
    }

    match /cotizador_config/{doc} {
      allow read: if dentro();
      allow write: if esAdmin();
    }

    match /cotizador_catalogo/{doc} {
      allow read: if dentro();
      allow write: if esAdmin();
    }
  }
}
